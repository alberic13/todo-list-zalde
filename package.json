{
  "name": "todo-list-zalde",
  "version": "1.0.0",
  "description": "Enterprise-grade Fullstack Todo App with React 19, Tailwind v4, Bun, Elysia, Drizzle ORM, pgvector RAG, Playwright E2E & CI/CD",
  "author": {
    "name": "Muchammad Zalde Zahwa Putra",
    "url": "https://github.com/alberic13"
  },
  "keywords": [
    "react19",
    "tailwind-v4",
    "bun",
    "elysia",
    "drizzle-orm",
    "pgvector",
    "rag",
    "playwright",
    "github-actions",
    "upstash-redis"
  ],
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "db:seed": "cd backend && bun run db:seed",
    "build": "cd frontend && npm run build",
    "lint:backend": "cd backend && bun run typecheck",
    "lint:frontend": "cd frontend && npm run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test": "cd backend && bun test",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:all": "npm run lint && npm run test && npm run test:e2e"
  }
}
